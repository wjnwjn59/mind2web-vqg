# Copy this file to `.env` and fill in your real keys.
# `.env` is gitignored, so do NOT commit your keys to GitHub.

# ---- API baseline (OpenAI) ----
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# Optional: override the base_url when using a proxy / OpenAI-compatible endpoint
# OPENAI_BASE_URL=https://api.openai.com/v1

# ---- HuggingFace (only needed for private models or a higher rate limit) ----
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxx

# ---- Data directory ----
# Local: ./data . On the lab server: /mnt/data/datasets/Mind2Web
# MIND2WEB_DATA_DIR=/mnt/data/datasets/Mind2Web

# ---- Model weights directory ----
# Local: ./hf-cache . On the lab server: /mnt/data/hf-cache
# MIND2WEB_HF_CACHE=/mnt/data/hf-cache
